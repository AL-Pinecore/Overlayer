{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Overlayer",
  "version": "0.1.0",
  "identifier": "com.pinehouse.overlayer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "/",
        "title": "Overlayer",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "overlay",
        "url": "/overlay",
        "visible": false,
        "skipTaskbar": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "./Info.plist"
    }
  }
}
